<div class="course-item js-course-item">

{% set tagClass = "" %}

{% if course.status == "Open for funding" %}
  {% set tagClass = "govuk-tag--green" %}
{% elif course.status == "Funding closing for new starts" %}
  {% set tagClass = "govuk-tag--orange" %}
{% elif course.status == "Funding closed for new starts" %}
  {% set tagClass = "govuk-tag govuk-tag--light-grey" %}
  {% elif course.status == "Funding not available yet" %}
  {% set tagClass = "govuk-tag govuk-tag--yellow" %}
{% endif %}

{% set isMarkedForRemoval =
  course.action == "Marked as inactive"
  and course.larsCode not in (data.keptCourses or [])
%}


{{ govukTag({
  text: course.status,
  classes: tagClass
}) }}

  <div class="course-title">

    <h2 class="govuk-heading-m govuk-!-margin-bottom-1 govuk-!-margin-top-3"><a href="/individual-course/{{ course.larsCode }}">
      {{ course.title }}</a>
    </h2>
    

  </div>

{% if course.status == "Funding closed for new starts" %}
<p class="govuk-!-margin-top-3"><b>Funding status:</b> We’ve closed this apprenticeship to new starts. This means you can no longer claim funding for any learners you enrol. </p>
{% endif %}

{% if course.status == "Funding not available yet" %}
<p class="govuk-!-margin-top-3"><b>Funding status:</b> This course isn't available for delivery or enrolment, but can be advertised on Find apprenticeship training.</p>
{% endif %}

{% if course.status == "Funding closing for new starts" %}
<p class="govuk-!-margin-top-3"><b>Funding status:</b> We’ve added a last start date for learners to this course. You can claim funding for learners you enrol up until this date. </p>
{% endif %}


<div class="course-info">
  <p>
    <b>LARS code</b>: {{ course.larsCode }}
  </p>


{% if course.status == "Funding closing for new starts" and course.laststartDate %}
  <p>
    <b>Last start date</b>: {{ course.laststartDate }}
  </p>
  
{% endif %}

{% if course.status == "Funding closed for new starts" and course.laststartDate %}
  <p>
    <b>Last start date</b>: {{ course.laststartDate }}
  </p>
{% endif %}



{% if isMarkedForRemoval %}
  {% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{{ govukWarningText({
  html: "This course is currently inactive and isn’t being shown on Find apprenticeship training. You can start advertising it again at any time.",
  iconFallbackText: "Warning"
}) }}
{% endif %}

{% if course.action == "Details needed" %}
  {% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{{ govukWarningText({
  html: "This apprenticeship is missing information, which means it’s not showing on Find apprenticeship training. Update your details to advertise it. ",
  iconFallbackText: "Warning"
}) }}
{% endif %}

</div>


</div>